;; sapf.stac: sapf's DSP words, imported unqualified, and the prelude definitions built on them.
;; The core keeps these words in the namespace sapf (docs/dev/stac.md, Phases 5).
;; Load it after prelude.stac, whose UGens it replaces:
;;   stac -p prelude.stac -p sapf.stac examples/sapf.stac

;; sapf's words, over the bare UGens prelude.stac imports. N, keep, NZ and T also end a UGen;
;; play leaves nothing. They are core words, so they are imported by name.
import std.*
import sapf.*
import sapf.N sapf.keep sapf.NZ sapf.T sapf.play

"\\n*** unipolar random number generators ***" helpLine
	
def urandz --> sig
	"return a signal of random numbers from 0 to 1."
	[0 1 randz]
	
def nurandz n --> sig
	"return a signal of n random numbers from 0 to 1."
	[n 0 1 nrandz]

"\\n*** bipolar random number generators ***" helpLine
	
def brandz --> sig
	"return a signal of random numbers from -1 to 1."
	[1 rand2z]
	
def nbrandz n --> sig
	"return a signal of n random numbers from -1 to 1."
	[n 1 nrand2z]
	
"\\n*** random walks ***" helpLine

def iwalkz step lo hi --> sig
	"integer random walk."
	[step irand2z +\ lo hi irand + lo hi ifold  ]

def iwalk2z step limit --> sig
	"integer random walk. bipolar bounds."
	[step irand2z +\ limit irand2 + limit ifold2  ]

def walkz step lo hi --> sig
	"random walk."
	[step rand2z +\ lo hi rand + lo hi fold  ]

def walk2z step limit --> sig
	"random walk. bipolar bounds."
	[step rand2z +\ limit rand2 + limit fold2  ]

"\\n*** composite ugens ***" helpLine

def oltx sounds susTime xfadeTime density numChannels --> sig
	"texture of overlapping sounds. OverlapTexture, adapted from SC2"
	[
		xfadeTime 2 * susTime + density / = period 
		#[0 1 1 0] = levels
		#[xfadeTime susTime xfadeTime] = times
		`sounds type 'Fun equals 
		\[ \i[ i sounds levels times 1 lines * ] period 1 numChannels ola ]
		\[ sounds @ \sound[ sound levels times 1 lines *] ! period 1 numChannels ola ] if
	]

def xftx sounds susTime xfadeTime numChannels --> sig
	"texture of crossfaded sounds. XFadeTexture, adapted from SC2"
	[
		xfadeTime susTime + = period 
		#[0 1 1 0] = levels
		#[xfadeTime susTime xfadeTime] = times
		`sounds type 'Fun equals 
		\[ \i[ i sounds levels times 1 lines * ] period 1 numChannels ola ]
		\[ sounds @ \sound[ sound levels times 1 lines *] ! period 1 numChannels ola ] if
	]

def lfo freq phase lo hi --> sig
	"sine wave lfo with linear range."
	[freq phase sinosc lo hi bilin]

def xlfo freq phase lo hi --> sig
	"sine wave lfo with exponential range."
	[freq phase sinosc lo hi biexp]

def splay x --> sig
	"evenly spread an array of mono sources across a stereo field."
	[x L1 aa size -1 1 lindiv pan2 +/]

def rsplay x --> sig
	"evenly spread an array of mono sources across a stereo field."
	[x L1 = list x 0 list size -1 1 lindiv brand + rot2 +/]

def splayd x maxdelay --> sig
	"evenly spread an array of mono sources across a stereo field using interaural time delay."
	[x L1 aa size -1 1 lindiv maxdelay itd +/]

;;.4 white .1 100 xmousex phaser play

"\\n*** simple allpass reverbs ***" helpLine

def apverb4 in delayTime decayTime --> sig
	"four stage stereo allpass with random delay times"
	[	
		in size 2 | = n
		\z[ z \[.1m delayTime rand] n X aa decayTime alpasn] = r
		in r r r r
	]

def apverb6 in delayTime decayTime --> sig
	"six stage stereo allpass with random delay times"
	[	\z[ z \[.1m delayTime rand] 2X aa decayTime alpasn] = r
		in r r r r r r
	]

"\\n*** random sweeps and pans ***" helpLine

def rline dur lo hi --> sig
	"random line. both ends are uniformly random between lo and hi."
	[dur lo hi rand lo hi rand line]

def xrline dur lo hi --> sig
	"exponentially random line. both ends are exponentially random between lo and hi."
	[dur lo hi xrand lo hi xrand line]

def rxline dur lo hi --> sig
	"random exponential line. both ends are uniformly random between lo and hi."
	[dur lo hi rand lo hi rand xline]

def xrxline dur lo hi --> sig
	"exponentially random exponential line. both ends are exponentially random between lo and hi."
	[dur lo hi xrand lo hi xrand xline]

def rpanl2 in --> sig
	"stereo pan at a fixed random position."
	[in 1 rand2 pan2]

def rpan2 in --> sig
	"stereo pan at a fixed random position."
	[in 1 rand2 1m itd]

def rbal2 a b --> sig
	"stereo balance at a fixed random position."
	[a b 1 rand2 bal2]

def rrot2 in --> sig
	"stereo rotation at a fixed random position."
	[in 0 1 rand2 rot2]

def rsweeppan2 in dur --> sig
	"stereo pan with a random sweep."
	[in dur 1 rand2 1 rand2 line pan2]


"\\n*** crossover filters ***" helpLine

def crossover in freq --> sig sig
	"Linkwitz-Riley crossover filters: the high band, then the low band. Their sum has a flat frequency response."
	[in freq hpf2  in freq lpf2]

def crossover1 in freq --> sig sig
	"first order crossover filters: the high band, then the low band. Their sum has a flat frequency response."
	[in freq hpf1  in freq lpf1]

def midcrossover in freq bw --> sig sig
	"middle crossover: the outer band, then the inner band. Their sum has a flat frequency response."
	[in freq bw bsf  in freq bw bpf]

def crossovermix a b freq --> sig
	"Linkwitz-Riley crossover mixer."
	[a freq hpf2  b freq lpf2 +]

def crossover1mix a b freq --> sig
	"Linkwitz-Riley crossover mixer."
	[a freq hpf1  b freq lpf1 +]

def midcrossovermix a b freq bw --> sig
	"Linkwitz-Riley crossover mixer."
	[a freq bw bsf  b freq bw bpf +]


;; crossover tests:
;; \[20 20 20k xline 0 sinosc .5 * = x x 632 crossover = lo = hi  [x lo hi + lo hi]] ! "crossover-test" >sf
;; \[20 20 20k xline 0 sinosc .5 * = x x 632 crossover1 = lo = hi  [x lo hi + lo hi]] ! "crossover1-test" >sf
;; \[20 20 20k xline 0 sinosc .5 * = x x 632 .5 midcrossover = mid = outer  [x mid outer + mid outer]] ! "midcrossover-test" >sf

"\\n*** delays with wet/dry mix ***" helpLine

def combnw in delay maxdelay decay wet --> sig
	"combn delay with wet/dry mix control."
	[in  in delay maxdelay decay combn wet fade2]
	
def comblw in delay maxdelay decay wet --> sig
	"combl delay with wet/dry mix control."
	[in  in delay maxdelay decay combl wet fade2]
	
def combcw in delay maxdelay decay wet --> sig
	"combc delay with wet/dry mix control."
	[in  in delay maxdelay decay combc wet fade2]


"\\n*** synths ***" helpLine

def blah pch dyn dur pan --> sig
	"saw->filter->amp synth voice"
[
	#[0 1 .3 0] -3 #[3m .1 dur .103 - .1 |] 1 curves = env
	dyn 0 1h 6h 12k linlinc env * = fc
	dyn 0 1h -20 -10 linlinc dbamp = amp
	pch 1/12 * ohz [.1 -.1] + 0 [1 1] rand saw fc lpf2 env amp * * 
]

def lfblah pch dyn dur pan --> sig
	"lfsaw->filter->amp synth voice"
[
	#[0 1 .3 0] -3 #[3m .1 dur .103 - .1 |] 1 curves = env
	
	dyn 0 1h 6h 12k linlinc env * = fc
	dyn 0 1h -20 -10 linlinc dbamp = amp
	pch 1/12 * ohz [.1 -.1] + 0 [1 1] rand lfsaw fc lpf2 env amp * * 
]

;; [-12 0 4 6 10 14 20] 2 - @ 70 12 0 blah 0 .3 by dly +/ play

;; meanings of arguments:
;; freq - frequency in hertz
;; duty - duty cycle for variable width pulse or saw
;; db - peak amplitude in decibels
;; dur - duration in seconds
;; pan - pan position (-1 to +1)
;; harms - number of harmonics. determines the filter cutoff frequency
;; rq - the filter resonance, expressed as 1/Q.
;; adsr - an array containing [attack-time decay-time sustain-level release-time
;; c - carrier frequency multiplier
;; m - modulator frequency multiplier
;; mx - index of frequency modulation in cycles
;; fb - amount of phase modulation self feedback for the modulator
;; wt - wavetable


def adsrenv adsr dur --> sig
	"an envelope signal for a note of dur seconds. adsr is [attack-time decay-time sustain-level release-time]."
[
	adsr un4 = r = s = d = a
	#[0 1 s s 0] -3 #[a d dur a - d - 0 | r] 1 curves	
]

def saw-syn freq db dur pan harms adsr --> sig
	"sawtooth wave synth"
[
	adsr dur adsrenv = env
	freq harms * freqLimit & env * = fc
	db dbamp env * = amp
	freq 0 saw fc lpf2 amp * pan pan2
]

def square-syn freq db dur pan harms adsr --> sig
	"square wave synth"
[
	adsr dur adsrenv = env
	freq harms * freqLimit & env * = fc
	db dbamp env * = amp
	freq 0 .5 pulse fc lpf2 amp * pan pan2
]

def pulse-syn freq duty db dur pan harms adsr --> sig
	"variable width pulse wave synth"
[
	adsr dur adsrenv = env
	freq harms * freqLimit & env * = fc
	db dbamp env * = amp
	freq 0 duty pulse fc lpf2 amp * pan pan2
]

def osc-syn freq db dur pan harms adsr wt --> sig
	"wavetable oscillator synth"
[
	adsr dur adsrenv = env
	freq harms * freqLimit & env * = fc
	db dbamp env * = amp
	freq 0 wt osc fc lpf2 amp * pan pan2
]


def saw-rsyn freq db dur pan harms rq adsr --> sig
	"sawtooth wave synth with resonant lpf"
[
	adsr dur adsrenv = env
	freq harms * freqLimit & env * = fc
	db dbamp env * = amp
	freq 0 saw fc rq rlpf2 amp * pan pan2
]

def square-rsyn freq db dur pan harms rq adsr --> sig
	"square wave synth with resonant lpf"
[
	adsr dur adsrenv = env
	freq harms * freqLimit & env * = fc
	db dbamp env * = amp
	freq 0 .5 pulse fc rq rlpf2 amp * pan pan2
]

def fm-syn freq c m mx fb db dur pan adsr --> sig
	"fm synth"
[
	adsr dur adsrenv = env
	db dbamp env * = amp
	freq c * = cf
	freq m * = mf
	cf (mf 0 fb sinoscfb env mx * *) sinosc amp * pan pan2
]

def fm-syn3 freq c m mx fb db dur pan adsr --> sig
	"3 detuned carrier, 1 modulator fm"
[
	adsr dur adsrenv = env
	db dbamp env * = amp
	freq c * = cf
	freq m * = mf
	mf 0 fb sinoscfb env mx * * = mod
	cf mod sinosc cf .2 + mod sinosc cf .2 - mod sinosc + + amp * pan pan2
]

;;;;;;;
"\\n*** events ***" helpLine
	
{
	;; base event. contains common default arguments for instruments. 
	;; a particular instrument will use only some of the arguments.
	
	:freq 	0 ohz 	; frequency in Hertz
	:duty	.5		; duty cycle. 0 to 1 cycles
	:phase	0		; phase. 0 to 1 cycles
	
	;; timing
	:dur	1		; beats
	:dt		\o[ o.dur ]		; delta time to next event in beats. default is to return the duration
	:sus	\o[ o.dur o.legato * o.susmin | ]	; the time to sustain a note, in beats.
	:legato	1		; proportion of the note duration to sustain a note.
	:susmin	0		; minimum time to sustain a note, in beats.
	
	:pan	0		; -1 to 1
	:harms	8		; number of harmonics. determines the filter cutoff frequency
	:rq		.25		; 1/Q
	:c		1		; carrier frequency multiplier.
	:m		1		; modulator frequency multiplier.
	:mx		1		; modulation index in radians.
	:fb		0		; amplitude of feedback modulation.
	:wt		sawTbl	; wave table.
	
	;; amplitude envelope
	:db		-20		; decibels
	:amp	\o[ o.db dbamp ]	; amplitude
	:adsr	[2m 2 0 .1]	; an array containing [attack-time decay-time sustain-level release-time]
	:env	\o[ o.adsr o.amp o.sus 1 adsr ]	; creates an adsr envelope
	
	:out	\o[ o `osc-syn !e ]	; extracts the event fields and passes them to osc-syn
} = ev-base

"ev-base - a form containing the basic low level information for a music event." helpLine

; a simple sound for testing
{
        :freq   1k      ; hz
        :db     -12     ; dB
        :dur    1       ; beats
        :hop    \o[o.dur]
        :out    \o[ (o.freq 0 sinosc) (#[0 1 0] o.db dbamp * -4 #[1m .4] 1 curves) * ]
} = tink
